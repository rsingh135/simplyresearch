<!-- Hero Section -->
<div class="hero-section text-center">
  <div class="container">
    <h1 class="hero-title">Transform your research into professional presentations</h1>
    <p class="hero-subtitle">
      Upload your PDF and let our AI create comprehensive summaries and stunning slides—instantly.
    </p>
  </div>
</div>

<!-- File Upload Section -->
<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
      <%= form_with(model: @document, class: "upload-form") do |form| %>
        <div class="card shadow-lg border-0 upload-card">
          <div class="card-body p-5">
            <div class="text-center mb-4">
              <div class="upload-icon mb-4">
                <div class="upload-icon-bg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-file-earmark-arrow-up text-primary" viewBox="0 0 16 16">
                    <path d="M8.5 11.5a.5.5 0 0 1-1 0V7.707L6.354 8.854a.5.5 0 1 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 7.707V11.5z"/>
                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                  </svg>
                </div>
              </div>
              <h3 class="upload-title mb-2">Upload Your Research Paper</h3>
              <p class="upload-subtitle">Drag and drop your PDF file here, or click to browse</p>
            </div>
            
            <div class="mb-3">
              <%= form.file_field :pdf, class: "form-control form-control-lg file-input", accept: "application/pdf", direct_upload: true, required: true %>
            </div>
            
            <div class="mb-4">
              <%= form.text_field :title, class: "form-control dark-input", placeholder: "Enter a title for your research paper (optional)", value: "" %>
            </div>
            
            <div class="d-grid">
              <%= form.submit "Upload & Process", class: "btn btn-primary btn-lg" %>
            </div>
            
            <div class="text-center mt-3">
              <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Supports PDF files up to 10MB
              </small>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>


<!-- How It Works Section -->
<div class="how-it-works-section py-5 mt-5">
  <div class="container">
    <div class="row text-center mb-5">
      <div class="col-12">
        <h2 class="display-5 fw-bold mb-3">How It Works</h2>
        <p class="lead text-muted">Three simple steps to transform your research</p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="text-center p-4">
          <div class="step-number mb-4">
            <span class="step-badge">1</span>
          </div>
          <h4 class="step-title">Upload</h4>
          <p class="step-text text-muted">Upload your research paper in PDF format. We support files up to 10MB.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="text-center p-4">
          <div class="step-number mb-4">
            <span class="step-badge">2</span>
          </div>
          <h4 class="step-title">Analyze</h4>
          <p class="step-text text-muted">Our AI analyzes your paper, extracting the abstract and key methodology points.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="text-center p-4">
          <div class="step-number mb-4">
            <span class="step-badge">3</span>
          </div>
          <h4 class="step-title">Present</h4>
          <p class="step-text text-muted">Get a professional Google Slides presentation generated automatically from the analysis.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Features Section -->
<div class="features-section py-5 mt-5 mb-5">
  <div class="container">
    <div class="row text-center mb-5">
      <div class="col-12">
        <h2 class="display-5 fw-bold mb-3">Why Choose SimplyResearch?</h2>
