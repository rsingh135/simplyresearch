<!-- Hero Section -->
<div class="hero-section text-center py-4 mb-3">
  <div class="container">
    <h1 class="display-4 fw-bold mb-3">Services</h1>
    <p class="lead mb-3 mx-auto" style="max-width: 600px;">
      Learn how to use SimplyResearch to transform your research papers into professional presentations with our comprehensive guide.
    </p>
  </div>
</div>

<!-- Getting Started Section -->
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-lg border-0 mb-5">
        <div class="card-body p-5">
          <h2 class="h3 mb-4 text-center text-dark">Getting Started</h2>
          <p class="lead text-center text-muted mb-4">
            SimplyResearch makes it easy to create professional presentations from your research papers. Follow these simple steps to get started.
          </p>
          <div class="text-center">
            <%= link_to "Start Creating Presentations", root_path, class: "btn btn-primary btn-lg" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Step-by-Step Guide -->
<div class="container py-5">
  <div class="row text-center mb-5">
    <div class="col-12">
      <h2 class="display-5 fw-bold mb-3">Step-by-Step Guide</h2>
      <p class="lead">Follow these detailed steps to create your presentation</p>
    </div>
  </div>
  
  <div class="row g-4">
    <div class="col-lg-4 col-md-6">
      <div class="card h-100 border-0 shadow-sm feature-card">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <div class="step-number mb-3">
              <span class="step-badge">1</span>
            </div>
            <h4 class="card-title mb-3">Upload Your Research Paper</h4>
          </div>
          <div class="service-content">
            <ul class="list-unstyled">
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Click on the "Choose File" button</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Select your PDF research paper</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>File must be under 10MB</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Only PDF files are supported</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Optionally add a title for your paper</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4 col-md-6">
      <div class="card h-100 border-0 shadow-sm feature-card">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <div class="step-number mb-3">
              <span class="step-badge">2</span>
            </div>
            <h4 class="card-title mb-3">AI Processing & Analysis</h4>
          </div>
          <div class="service-content">
            <ul class="list-unstyled">
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Click "Upload & Process" button</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>AI analyzes your paper content</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Extracts key findings and methodology</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Creates comprehensive summary</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Generates bullet points automatically</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4 col-md-6">
      <div class="card h-100 border-0 shadow-sm feature-card">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <div class="step-number mb-3">
              <span class="step-badge">3</span>
            </div>
            <h4 class="card-title mb-3">Generate Presentation</h4>
          </div>
          <div class="service-content">
            <ul class="list-unstyled">
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Review your AI-generated summary</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Click "Generate Slides" button</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>AI creates professional slides</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Proper formatting and visual hierarchy</li>
              <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Download or view your presentation</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Features & Benefits -->
<div class="container py-5">
  <div class="row text-center mb-5">
    <div class="col-12">
      <h2 class="display-5 fw-bold mb-3">What You Get</h2>
      <p class="lead">Professional results in minutes</p>
    </div>
  </div>
  
  <div class="row g-4">
    <div class="col-lg-6 col-md-6">
      <div class="card h-100 border-0 shadow-sm feature-card">
        <div class="card-body p-4">
          <div class="d-flex align-items-start">
            <div class="feature-icon me-3">
              <div class="feature-icon-bg">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-file-text text-primary" viewBox="0 0 16 16">
