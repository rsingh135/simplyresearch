<!-- CTA Section -->
<div class="container py-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 text-center">
      <div class="card shadow-lg border-0">
        <div class="card-body p-5">
          <h2 class="section-title mb-4">Ready to Transform Your Research?</h2>
          <p class="section-text mb-4">
            Join thousands of researchers and students who are already using SimplyResearch to create compelling presentations.
          </p>
          <%= link_to "Get Started Now", root_path, class: "btn btn-primary btn-lg" %>
        </div>
      </div>
    </div>
  </div>
</div>