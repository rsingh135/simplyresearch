<!-- Hero Section -->
<div class="hero-section text-center">
  <div class="container">
    <h1 class="hero-title">How It Works</h1>
    <p class="hero-subtitle">
      Empowering researchers and students to transform complex academic papers into compelling presentations with the power of AI.
    </p>
  </div>
</div>

<!-- Mission Section -->
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card shadow-lg border-0 mb-5">
        <div class="card-body p-5">
          <h2 class="section-title mb-4 text-center">Our Mission</h2>
          <p class="section-text text-center mb-4">
            We believe that groundbreaking research deserves to be communicated effectively. SimplyResearch bridges the gap between complex academic content and engaging presentations.
          </p>
          <p class="section-text text-center">
            Our AI-powered platform helps researchers, students, and academics transform their papers into professional presentations in minutes, not hours.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- How It Works Section -->
<div class="container py-5 mb-5">
  <div class="row text-center mb-5">
    <div class="col-12">
      <h2 class="section-heading mb-3">How It Works</h2>
      <p class="section-subtitle">Three simple steps to transform your research</p>
    </div>
  </div>
  
  <div class="row g-4">
    <div class="col-lg-4 col-md-6">
      <div class="card h-100 border-0 shadow-sm feature-card">
        <div class="card-body text-center p-4">
          <div class="feature-icon mb-3">
            <div class="feature-icon-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-upload text-primary" viewBox="0 0 16 16">
                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
              </svg>
            </div>
          </div>
          <h4 class="step-title mb-3">1. Upload Your Paper</h4>
          <p class="step-text">
            Simply drag and drop your PDF research paper or click to browse. Our system supports files up to 10MB.
          </p>
        </div>
      </div>
    </div>

    <div class="col-lg-4 col-md-6">
      <div class="card h-100 border-0 shadow-sm feature-card">
        <div class="card-body text-center p-4">
          <div class="feature-icon mb-3">
            <div class="feature-icon-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-cpu text-primary" viewBox="0 0 16 16">
                <path d="M5 0a.5.5 0 0 1 .5.5V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2A2.5 2.5 0 0 1 14 4.5h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14a2.5 2.5 0 0 1-2.5 2.5v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14A2.5 2.5 0 0 1 2 11.5H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2A2.5 2.5 0 0 1 4.5 2V.5A.5.5 0 0 1 5 0zm-.5 3A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 11.5 3h-7zM5 6.5A1.5 1.5 0 0 1 6.5 5h3A1.5 1.5 0 0 1 11 6.5v3A1.5 1.5 0 0 1 9.5 11h-3A1.5 1.5 0 0 1 5 9.5v-3zM6.5 6a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z"/>
              </svg>
            </div>
          </div>
          <h4 class="step-title mb-3">2. AI Processing</h4>
          <p class="step-text">
            Our advanced AI analyzes your paper, extracts key findings, and creates a comprehensive summary with bullet points.
          </p>
        </div>
      </div>
    </div>

    <div class="col-lg-4 col-md-6">
      <div class="card h-100 border-0 shadow-sm feature-card">
        <div class="card-body text-center p-4">
          <div class="feature-icon mb-3">
            <div class="feature-icon-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-easel text-primary" viewBox="0 0 16 16">
                <path d="M8 0a.5.5 0 0 1 .473.337L9.046 2H14a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-1.85l1.323 3.837a.5.5 0 1 1-.946.326L11.092 11H8.5v3a.5.5 0 0 1-1 0v-3H4.908l-1.435 4.163a.5.5 0 1 1-.946-.326L3.85 11H2a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h4.954L7.527.337A.5.5 0 0 1 8 0M2 3v7h12V3z"/>
              </svg>
            </div>
          </div>
          <h4 class="step-title mb-3">3. Generate Slides</h4>
          <p class="step-text">
            Click "Generate Slides" and watch as our AI creates professional presentation slides with proper formatting and visual hierarchy.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

