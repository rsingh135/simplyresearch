<div class="container py-5">
  <!-- Document Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <%= link_to documents_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i> Back to Library
          <% end %>
          
          <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              Actions
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
              <li>
                <button class="dropdown-item" onclick="toggleRename()">
                  <i class="bi bi-pencil me-2"></i> Rename
                </button>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to document_path(@document), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this research paper?" }, class: "dropdown-item text-danger" do %>
                  <i class="bi bi-trash me-2"></i> Delete
                <% end %>
              </li>
            </ul>
          </div>
        </div>

        <div id="title-container">
          <h1 class="section-title mb-2"><%= @document.title.present? ? @document.title : "Research Paper" %></h1>
        </div>

        <div id="rename-form" class="d-none mb-3">
          <%= form_with(model: @document, class: "d-flex gap-2 align-items-center") do |f| %>
            <%= f.text_field :title, class: "form-control form-control-lg", value: @document.title, style: "max-width: 400px;" %>
            <%= f.submit "Save", class: "btn btn-primary" %>
            <button type="button" class="btn btn-outline-secondary" onclick="toggleRename()">Cancel</button>
          <% end %>
        </div>

        <p class="text-muted mb-0">Uploaded on <%= @document.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      </div>
    </div>
  </div>

  <!-- Status-based Content -->
  <% if @document.status == "generating_presentation" %>
    <div id="generating-status-container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-lg border-0">
            <div class="card-body text-center p-5">
              <div class="mb-4">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                  <span class="visually-hidden">Generating...</span>
                </div>
              </div>
              <h3 class="section-title mb-3">Generating Your Presentation</h3>
              <p class="section-text text-muted mb-4">Our AI is creating your Google Slides presentation. This may take a few moments.</p>
              <div class="progress mb-3" style="height: 8px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 75%"></div>
              </div>
              <small class="text-muted">Please don't close this page while generating...</small>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <script>
      (function() {
        const docId = '<%= @document.id %>';
        const statusUrl = '<%= status_document_path(@document, format: :json) %>';
        const docUrl = '<%= document_path(@document) %>';
        let pollInterval;
        
        function checkStatus() {
          fetch(statusUrl, {
            method: 'GET',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
          })
          .then(response => {
            if (!response.ok) {
              throw new Error('Failed to fetch status');
            }
            return response.json();
          })
          .then(data => {
            const currentStatus = data.status || 'generating_presentation';
            const finalStatuses = ['presentation_generated', 'presentation_failed'];
            
            if (finalStatuses.includes(currentStatus)) {
              clearInterval(pollInterval);
              setTimeout(() => {
                window.location.href = docUrl;
              }, 500);
            }
          })
          .catch(error => {
            console.error('Error checking status:', error);
          });
        }
        
        pollInterval = setInterval(checkStatus, 3000);
        checkStatus();
      })();
    </script>

  <% elsif @document.status == "presentation_generated" %>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-lg border-0">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <div class="success-icon-circle mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                  <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.061L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                </svg>
              </div>
            </div>
            <h3 class="section-title mb-3">Presentation Ready!</h3>
            <p class="section-text text-muted mb-4">Your presentation has been successfully generated and is ready to view.</p>
            <%= link_to @document.presentation_url, target: "_blank", class: "btn btn-primary btn-lg" do %>
              <i class="bi bi-file-earmark-slides me-2"></i>Open Presentation
            <% end %>
          </div>
        </div>
      </div>
    </div>

  <% elsif @document.status == "generated" %>
    <div class="row">
      <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
          <div class="card-header">
            <h3 class="card-title mb-0">
              <i class="bi bi-file-text me-2"></i>Research Summary
            </h3>
          </div>
          <div class="card-body">
            <h5 class="section-title mb-4">Abstract</h5>
            <div class="abstract-content p-4 rounded mb-5">
              <p class="section-text mb-0"><%= @document.summary %></p>
            </div>
            
            <h5 class="section-title mb-4">Key Points</h5>
            <ul class="list-unstyled key-points-list">
              <% @document.key_points.each_with_index do |point, index| %>
                <li class="mb-3">
                  <div class="d-flex align-items-start">
                    <span class="badge bg-primary me-3 mt-1 flex-shrink-0"><%= index + 1 %></span>
                    <span class="section-text"><%= point %></span>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="col-lg-4">
        <div class="card shadow-sm action-card">
          <div class="card-body text-center p-4">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-easel text-primary" viewBox="0 0 16 16">
                <path d="M8 0a.5.5 0 0 1 .473.337L9.046 2H14a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-1.85l1.323 3.837a.5.5 0 1 1-.946.326L11.092 11H8.5v3a.5.5 0 0 1-1 0v-3H4.908l-1.435 4.163a.5.5 0 1 1-.946-.326L3.85 11H2a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h4.954L7.527.337A.5.5 0 0 1 8 0M2 3v7h12V3z"/>
              </svg>
            </div>
            <h5 class="section-title mb-3">Generate Presentation</h5>
            <p class="section-text mb-4">Create professional slides from your research summary</p>
            <%= button_to generate_presentation_document_path(@document), method: :post, class: "btn btn-primary btn-lg w-100" do %>
              <i class="bi bi-magic me-2"></i>Generate Slides
            <% end %>
          </div>
        </div>
      </div>
    </div>

  <% elsif @document.status == "presentation_failed" %>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-lg border-0 border-start border-4 border-danger">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <div class="error-icon-circle mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                  <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                </svg>
              </div>
            </div>
            <h3 class="section-title mb-3 text-danger">Generation Failed</h3>
            <p class="section-text text-muted mb-4">An error occurred while generating the presentation. Please try again.</p>
            <%= button_to generate_presentation_document_path(@document), method: :post, class: "btn btn-primary btn-lg" do %>
              <i class="bi bi-arrow-clockwise me-2"></i>Retry Generation
            <% end %>
          </div>
        </div>
      </div>
    </div>

  <% elsif @document.status == "processing_failed" %>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-lg border-0 border-start border-4 border-danger">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <div class="error-icon-circle mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                  <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                </svg>
              </div>
            </div>
            <h3 class="section-title mb-3 text-danger">Processing Failed</h3>
            <p class="section-text text-muted mb-4">An error occurred while processing your document.</p>
            <%= link_to "Upload a New Document", root_path, class: "btn btn-primary btn-lg" %>
          </div>
        </div>
      </div>
    </div>

  <% else %>
    <div id="processing-status-container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-lg border-0">
            <div class="card-body text-center p-5">
              <div class="mb-4">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                  <span class="visually-hidden">Processing...</span>
                </div>
              </div>
              <h3 class="section-title mb-3">Processing Your Document</h3>
              <p class="section-text text-muted mb-4">Our AI is analyzing your research paper.</p>
              <div class="progress mb-3" style="height: 8px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 75%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <script>
      (function() {
        const docId = '<%= @document.id %>';
        const statusUrl = '<%= status_document_path(@document, format: :json) %>';
        const docUrl = '<%= document_path(@document) %>';
        let pollInterval;
        
        function checkStatus() {
          fetch(statusUrl, {
            method: 'GET',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
          })
          .then(response => response.json())
          .then(data => {
            const currentStatus = data.status || 'pending';
            const finalStatuses = ['generated', 'presentation_generated', 'processing_failed', 'presentation_failed'];
            
            if (finalStatuses.includes(currentStatus)) {
              clearInterval(pollInterval);
              setTimeout(() => {
                window.location.href = docUrl;
              }, 500);
            }
          })
          .catch(error => console.error('Error checking status:', error));
        }
        
        pollInterval = setInterval(checkStatus, 3000);
        checkStatus();
      })();
    </script>
  <% end %>
</div>

<script>
  function toggleRename() {
    const titleContainer = document.getElementById('title-container');
    const renameForm = document.getElementById('rename-form');
    
    if (renameForm.classList.contains('d-none')) {
      renameForm.classList.remove('d-none');
      titleContainer.classList.add('d-none');
      renameForm.querySelector('input[type="text"]').focus();
    } else {
      renameForm.classList.add('d-none');
      titleContainer.classList.remove('d-none');
    }
  }
</script>
