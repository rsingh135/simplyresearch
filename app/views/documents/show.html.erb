<div class="container py-5">
  <!-- Document Header -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="d-flex align-items-center mb-3">
        <%= link_to root_path, class: "btn btn-outline-primary me-3" do %>
          <i class="bi bi-arrow-left me-1"></i> Back to Uploads
        <% end %>
        <h1 class="section-title mb-0"><%= @document.title.present? ? @document.title : "Research Paper" %></h1>
      </div>
      <div>
        <small class="text-muted">Uploaded on <%= @document.created_at.strftime("%B %d, %Y at %I:%M %p") %></small>
      </div>
    </div>
  </div>

  <!-- Status-based Content -->
  <% if @document.status == "generating_presentation" %>
    <div id="generating-status-container">
      <div class="row justify-content-center">
        <div class="col-lg-6">
          <div class="card border-info shadow-sm">
            <div class="card-body text-center p-5">
              <div class="mb-4">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Generating...</span>
                </div>
              </div>
              <h3 class="section-title text-info mb-3">Generating Your Presentation</h3>
              <p class="section-text text-muted mb-4">Our AI is creating your Google Slides presentation. This may take a few moments.</p>
              <div class="progress mb-3">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 75%"></div>
              </div>
              <small class="text-muted">Please don't close this page while generating...</small>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <script>
      // AJAX polling for presentation generation
      (function() {
        const docId = '<%= @document.id %>';
        const statusUrl = '<%= status_document_path(@document, format: :json) %>';
        const docUrl = '<%= document_path(@document) %>';
        let pollInterval;
        
        function checkStatus() {
          fetch(statusUrl, {
            method: 'GET',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
          })
          .then(response => {
            if (!response.ok) {
              throw new Error('Failed to fetch status');
            }
            return response.json();
          })
          .then(data => {
            const currentStatus = data.status || 'generating_presentation';
            const finalStatuses = ['presentation_generated', 'presentation_failed'];
            
            // If status changed to a final state, reload the page to show result
            if (finalStatuses.includes(currentStatus)) {
              clearInterval(pollInterval);
              setTimeout(() => {
                window.location.href = docUrl;
              }, 500);
            }
          })
          .catch(error => {
            console.error('Error checking status:', error);
          });
        }
        
        // Poll every 3 seconds
        pollInterval = setInterval(checkStatus, 3000);
        
        // Also check immediately
        checkStatus();
      })();
    </script>

  <% elsif @document.status == "presentation_generated" %>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-success shadow-sm">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.061L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
              </svg>
            </div>
            <h3 class="section-title text-success mb-3">Presentation Ready!</h3>
            <p class="section-text text-muted mb-4">Your presentation has been successfully generated and is ready to view.</p>
            <%= link_to @document.presentation_url, target: "_blank", class: "btn btn-success btn-lg" do %>
              <i class="bi bi-file-earmark-slides me-2"></i>Open Presentation
            <% end %>
          </div>
        </div>
      </div>
    </div>

  <% elsif @document.status == "generated" %>
    <div class="row">
      <div class="col-lg-8">
        <!-- Summary Section -->
        <div class="card shadow-sm mb-4">
          <div class="card-header">
            <h3 class="card-title mb-0">
              <i class="bi bi-file-text me-2"></i>Research Summary
            </h3>
          </div>
          <div class="card-body">
            <h5 class="section-title mb-4">Abstract</h5>
            <div class="abstract-content p-4 rounded mb-5">
              <p class="section-text mb-0"><%= @document.summary %></p>
            </div>
            
            <h5 class="section-title mb-4">Key Points</h5>
            <ul class="list-unstyled key-points-list">
              <% @document.key_points.each_with_index do |point, index| %>
                <li class="mb-3">
                  <div class="d-flex align-items-start">
                    <span class="badge bg-primary me-3 mt-1 flex-shrink-0"><%= index + 1 %></span>
                    <span class="section-text"><%= point %></span>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="col-lg-4">
        <!-- Action Card -->
        <div class="card shadow-sm action-card">
          <div class="card-body text-center p-4">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-easel text-primary" viewBox="0 0 16 16">
                <path d="M8 0a.5.5 0 0 1 .473.337L9.046 2H14a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-1.85l1.323 3.837a.5.5 0 1 1-.946.326L11.092 11H8.5v3a.5.5 0 0 1-1 0v-3H4.908l-1.435 4.163a.5.5 0 1 1-.946-.326L3.85 11H2a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h4.954L7.527.337A.5.5 0 0 1 8 0M2 3v7h12V3z"/>
              </svg>
            </div>
            <h5 class="section-title mb-3">Generate Presentation</h5>
            <p class="section-text mb-4">Create professional slides from your research summary</p>
            <%= button_to generate_presentation_document_path(@document), method: :post, class: "btn btn-primary btn-lg w-100" do %>
              <i class="bi bi-magic me-2"></i>Generate Slides
            <% end %>
          </div>
        </div>
      </div>
    </div>

  <% elsif @document.status == "presentation_failed" %>
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card border-danger shadow-sm">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle-fill text-danger" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
              </svg>
            </div>
            <h3 class="section-title text-danger mb-3">Generation Failed</h3>
            <p class="section-text text-muted mb-4">An error occurred while generating the presentation. Please try again.</p>
            <%= button_to generate_presentation_document_path(@document), method: :post, class: "btn btn-danger btn-lg" do %>
              <i class="bi bi-arrow-clockwise me-2"></i>Retry Generation
            <% end %>
          </div>
        </div>
      </div>
    </div>

  <% elsif @document.status == "processing_failed" %>
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card border-danger shadow-sm">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle-fill text-danger" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
              </svg>
            </div>
            <h3 class="section-title text-danger mb-3">Processing Failed</h3>
            <p class="section-text text-muted mb-4">An error occurred while processing your document. Please check your PDF file and try uploading again.</p>
            <%= link_to "Upload a New Document", root_path, class: "btn btn-primary btn-lg" %>
          </div>
        </div>
      </div>
    </div>

  <% else %>
    <div id="processing-status-container">
      <div class="row justify-content-center">
        <div class="col-lg-6">
          <div class="card border-info shadow-sm">
            <div class="card-body text-center p-5">
              <div class="mb-4">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Processing...</span>
                </div>
              </div>
              <h3 class="section-title text-info mb-3">Processing Your Document</h3>
              <p class="section-text text-muted mb-4">Our AI is analyzing your research paper and generating a comprehensive summary. This may take a few moments.</p>
              <div class="progress mb-3">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 75%"></div>
              </div>
              <small class="text-muted">Please don't close this page while processing...</small>
              <% if @document.status.nil? || @document.status == "" %>
                <div class="mt-3">
                  <small class="text-warning d-block">Note: Processing hasn't started yet. If this continues, the background job queue may not be running.</small>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <script>
      // AJAX polling - much better than full page reloads!
      (function() {
        const docId = '<%= @document.id %>';
        const statusUrl = '<%= status_document_path(@document, format: :json) %>';
        const docUrl = '<%= document_path(@document) %>';
        let pollInterval;
        let startTime = localStorage.getItem('doc_processing_start_' + docId);
        const now = new Date().getTime();
        const maxWaitTime = 300000; // 5 minutes in milliseconds
        
        if (!startTime) {
          localStorage.setItem('doc_processing_start_' + docId, now.toString());
        }
        
        function checkStatus() {
          fetch(statusUrl, {
            method: 'GET',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
          })
          .then(response => {
            if (!response.ok) {
              throw new Error('Failed to fetch status');
            }
            return response.json();
          })
          .then(data => {
            const currentStatus = data.status || 'pending';
            const finalStatuses = ['generated', 'presentation_generated', 'processing_failed', 'presentation_failed'];
            
            // Check timeout
            if (startTime) {
              const elapsed = new Date().getTime() - parseInt(startTime);
              if (elapsed > maxWaitTime) {
                clearInterval(pollInterval);
                localStorage.removeItem('doc_processing_start_' + docId);
                showTimeoutError();
                return;
              }
            }
            
            // If status changed to a final state, reload the page to show full content
            if (finalStatuses.includes(currentStatus)) {
              clearInterval(pollInterval);
              localStorage.removeItem('doc_processing_start_' + docId);
              // Smooth reload after a brief delay to show completion
              setTimeout(() => {
                window.location.href = docUrl;
              }, 500);
            }
          })
          .catch(error => {
            console.error('Error checking status:', error);
            // Continue polling even on error (might be temporary network issue)
          });
        }
        
        function showTimeoutError() {
          const container = document.getElementById('processing-status-container');
          if (container) {
            container.innerHTML = `
              <div class="row justify-content-center">
                <div class="col-lg-6">
                  <div class="card border-danger shadow-sm">
                    <div class="card-body text-center p-5">
                      <h3 class="section-title text-danger mb-3">Processing Timeout</h3>
                      <p class="section-text text-muted mb-4">Processing is taking longer than expected. This may indicate the background job queue is not running. Please check your server logs or contact support.</p>
                      <a href="<%= root_path %>" class="btn btn-primary btn-lg">Go Back to Home</a>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }
        }
        
        // Poll every 3 seconds
        pollInterval = setInterval(checkStatus, 3000);
        
        // Also check immediately
        checkStatus();
      })();
    </script>
  <% end %>
</div>

