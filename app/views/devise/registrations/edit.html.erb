<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg border-0 mb-4">
        <div class="card-body p-5">
          <div class="text-center mb-4">
            <h2 class="section-title mb-3">Account Settings</h2>
            <p class="section-text text-muted">Update your account information</p>
          </div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-4">
              <%= f.label :email, class: "form-label fw-semibold" %>
              <%= f.email_field :email, autofocus: true, class: "form-control form-control-lg", autocomplete: "email", placeholder: "Enter your email" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-info mb-4">
                Currently waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong>
              </div>
  <% end %>

            <div class="mb-4">
              <%= f.label :password, class: "form-label fw-semibold" %>
              <small class="text-muted d-block mb-1">Leave blank if you don't want to change it</small>
              <%= f.password_field :password, class: "form-control form-control-lg", placeholder: "New password (6 characters minimum)", autocomplete: "new-password" %>
  </div>

            <div class="mb-4">
              <%= f.label :password_confirmation, class: "form-label fw-semibold" %>
              <%= f.password_field :password_confirmation, class: "form-control form-control-lg", placeholder: "Confirm new password", autocomplete: "new-password" %>
  </div>

            <div class="mb-4">
              <%= f.label :current_password, class: "form-label fw-semibold" %>
              <small class="text-muted d-block mb-1">We need your current password to confirm your changes</small>
              <%= f.password_field :current_password, class: "form-control form-control-lg", placeholder: "Enter your current password", autocomplete: "current-password" %>
  </div>

            <div class="d-grid mb-3">
              <%= f.submit "Update Account", class: "btn btn-primary btn-lg" %>
            </div>

            <div class="text-center">
              <%= link_to "Back", :back, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
        </div>
      </div>

      <div class="card shadow-lg border-0 border-danger">
        <div class="card-body p-5">
          <h3 class="section-title mb-3 text-danger">Cancel My Account</h3>
          <p class="section-text text-muted mb-4">Permanently delete your account and all associated data</p>
          <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure? This action cannot be undone.", turbo_confirm: "Are you sure? This action cannot be undone." }, method: :delete, class: "btn btn-danger" %>
        </div>
      </div>
    </div>
  </div>
</div>
